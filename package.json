{
  "name": "jobtrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader native --no-file-parallelism",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project demo-jobtrack \"npm test\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-jobtrack"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
